# GankStore — contoh konfigurasi server. Salin ke .env lalu isi.
# JANGAN commit file .env (sudah ada di .gitignore) dan JANGAN taruh
# kunci asli di repo / frontend.
#
# Jalankan server:
#   uvicorn backend.main:app --host 127.0.0.1 --port 8000

# Alamat & port server (opsional, default 127.0.0.1:8000)
HOST=127.0.0.1
PORT=8000

# File database SQLite (default: backend/gankstore.db)
GANKSTORE_DB=backend/gankstore.db

# Akun demo PEMBELI untuk review Midtrans (demo@gankstore.my.id).
# 1 = dibuat otomatis saat server pertama jalan; 0 = jangan dibuat.
# Bukan akun admin. Ganti password ini sebelum toko dibuka untuk umum.
GS_SEED_DEMO=1
GS_DEMO_PASSWORD=Demo1234

# --- Midtrans (https://dashboard.midtrans.com > Settings > Access Keys) ---
# Isi dari dashboard. Server Key RAHASIA — hanya di server, jangan
# pernah ditempel di frontend / repo. Client Key boleh tampil di browser.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# 0 = Sandbox (mode tes, dulu). 1 = Production (hanya bila KYC sudah disetujui).
MIDTRANS_IS_PRODUCTION=0
